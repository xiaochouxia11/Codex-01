# Native USB console for flashing, logs, and the credential-free smoke controls.
CONFIG_ESP_CONSOLE_UART_CUSTOM=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y
# Accept a recovered media burst before the peer task drains the UDP socket.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
# The inherited file player is WAV-only; Live Voice uses a separate Opus codec.
CONFIG_AUDIO_PLAYER_ENABLE_MP3=n
CONFIG_AUDIO_PLAYER_ENABLE_WAV=y
