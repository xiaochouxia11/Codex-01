{
  "name": "openai-auth-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p playground/tsconfig.json --noEmit && tsc -p examples/browser/tsconfig.json --noEmit && tsc -p examples/authjs/tsconfig.json --noEmit",
    "playground": "pnpm build && pnpm --filter @openai/auth-playground dev",
    "playground:build": "pnpm --filter @openai/auth-playground build",
    "examples": "pnpm build && pnpm --filter @openai/auth-browser-examples dev",
    "examples:build": "pnpm --filter @openai/auth-browser-examples build",
    "test": "vitest run",
    "test:browser": "node scripts/check-browser-matrix.mjs",
    "test:browser:single": "playwright test",
    "check:packages": "publint packages/core && publint packages/react && node scripts/check-packages.mjs",
    "check:authjs-consumer": "node scripts/check-authjs-consumer.mjs",
    "i18n:extract": "node scripts/i18n/localize.ts extract",
    "i18n:compile": "node scripts/i18n/localize.ts compile",
    "i18n:check": "node scripts/i18n/localize.ts check",
    "check": "pnpm format:check && pnpm i18n:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:authjs && pnpm check:packages && pnpm check:authjs-consumer && pnpm test:browser && pnpm examples:build && pnpm example:authjs:build",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "example:authjs": "pnpm build && pnpm --filter @openai/auth-authjs-example dev",
    "example:authjs:build": "pnpm --filter @openai/auth-authjs-example build",
    "test:authjs": "pnpm --filter @openai/auth-authjs-example test",
    "check:distribution": "node scripts/distribution-inventory.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
