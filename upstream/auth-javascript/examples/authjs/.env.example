# These settings stay on the server. Supply your own registered OAuth client for identity only.
# Register this exact callback: http://127.0.0.1:4322/api/auth/callback/openai
NEXTAUTH_URL=http://127.0.0.1:4322
NEXTAUTH_SECRET=
OPENAI_CLIENT_ID=
OPENAI_ISSUER=https://auth.openai.com
# Use the method registered for this client. Never infer it from a secret.
# Public client: none. Confidential client: client_secret_basic.
OPENAI_TOKEN_ENDPOINT_AUTH_METHOD=none
# Leave this value empty for a public client. Keep confidential client secrets on the server.
OPENAI_CLIENT_SECRET=
