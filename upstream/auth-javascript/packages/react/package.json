{
  "name": "@openai/auth-react",
  "version": "0.1.0",
  "dependencies": {
    "@openai/auth": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "description": "React components and session profile UI for Sign in with ChatGPT integrations",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openai/auth-javascript.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/openai/auth-javascript/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/openai/auth-javascript/issues"
  },
  "keywords": [
    "chatgpt",
    "authentication",
    "sign-in",
    "oauth",
    "react"
  ]
}
