{
  "name": "@openai/auth",
  "version": "0.1.0",
  "description": "Branded Sign in with ChatGPT UI and interaction lifecycle for existing authentication systems",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "csstype": "3.2.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openai/auth-javascript.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/openai/auth-javascript/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/openai/auth-javascript/issues"
  },
  "keywords": [
    "chatgpt",
    "authentication",
    "sign-in",
    "oauth",
    "browser"
  ]
}
